# AI Model APIs (priority order: Grok > OpenAI > Claude > OpenRouter > Perplexity > Groq > ...)
# ============================================
GROK_API_KEY=your_grok_api_key_here
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions

# Optional: Add other AI providers for fallback
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local/Self-Hosted Models
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Web Search API
# ============================================
# Sign up at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Alternative: Use DuckDuckGo (no API key needed)
# SEARCH_ENGINE=duckduckgo

# Alchemy (blockchain data) for Opera/Alchemy integration
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_NETWORK=eth-mainnet

# Revenue wallet (private key must be kept secret; funds go here)
WALLET_PRIVATE_KEY=your_revenue_wallet_private_key
REVENUE_RECIPIENTS=0xYourAddr1,0xYourAddr2
# Optional token payout mode (if set, distribute this ERC-20 token instead of native ETH)
# Example for Base bridged WETH: 0x4200000000000000000000000000000000000006
PAYOUT_TOKEN_ADDRESS=
# Minimum per-recipient payout for native ETH mode (as ETH string)
MIN_PAYOUT_ETH=0
# Minimum per-recipient payout for token mode (raw token wei)
MIN_PAYOUT_TOKEN_WEI=0
# Retries and delay for transfer attempts
DISTRIBUTION_MAX_RETRIES=3
DISTRIBUTION_RETRY_BASE_MS=1000
# Optional: send webhook alerts on successful transfers
ALERT_ON_SUCCESS=false

# Vector Database (optional for production)
# ============================================
# For production, consider:
# - Pinecone (https://pinecone.io)
# - Weaviate (https://weaviate.io)
# - Milvus (https://milvus.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=freedomforge

# Knowledge Base Settings
# ============================================
KB_AUTO_LOAD_DATASETS=true
KB_INCLUDE_WIKIPEDIA=true
KB_INCLUDE_ARXIV=true
KB_INCLUDE_GITHUB=true

# Debug & Logging
# ============================================
DEBUG=true
LOG_LEVEL=info

# -------------------------------------------------------------------------
# Additional settings for revenue wallet monitoring & dashboard
# -------------------------------------------------------------------------
# Dashboard credentials (required to view /dashboard)
DASHBOARD_USER=admin
DASHBOARD_PASS=supersecretpassword

# Optional alerting
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_SECRET=some-secret-value

# Health / distribution URLs (used by GitHub Actions and monitor script)
HEALTH_URL=https://yourapp.example.com/api/alchemy/health
DISTRIBUTION_URL=https://yourapp.example.com/api/alchemy/wallet/distribute

# public-facing alchemy keys for client-side usage
NEXT_PUBLIC_ALCHEMY_API_KEY=u7P8SD8T_y5-JA9yHJQ2G
NEXT_PUBLIC_ALCHEMY_POLICY_ID=c3535f26-23ec-4acb-89ec-6dacafd62e2a

# Monitor interval (ms)
MONITOR_INTERVAL_MS=900000

# Alchemy WebSocket mined tx subscription (optional)
# JSON array of filter objects, e.g.:
# [{"to":"0x9f3ce0ad29b767d809642a53c2bccc9a130659d7","from":"0x228f108fd09450d083bb33fe0cc50ae449bc7e11"},{"to":"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"}]
ALCHEMY_MINED_ADDRESSES_JSON=
ALCHEMY_HASHES_ONLY=true
ALCHEMY_INCLUDE_REMOVED=false

# Token tracking (optional)
# Provide a comma-separated list of ERC-20 contract addresses you want the
# dashboard to display. Balances are retrieved via Alchemy using the same
# API key.
TRACKED_TOKENS=0xTokenAddr1,0xTokenAddr2

# Gas top-up configuration (optional)
# If you want the system to automatically top up the revenue wallet's gas
# from a funding wallet, set `FUNDING_PRIVATE_KEY` and adjust thresholds:
FUNDING_PRIVATE_KEY=
GAS_TOPUP_THRESHOLD=0.01   # in ETH; when revenue wallet falls below this, top up
GAS_TOPUP_AMOUNT=0.05      # in ETH; amount to send when topping up
