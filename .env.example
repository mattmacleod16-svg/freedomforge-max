# ─────────────────────────────────────────────────────────────────────────────
# FreedomForge Max — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables marked [REQUIRED] will cause /api/health to return 503 if missing.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION  [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════════

# Dashboard login credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-strong-password

# HMAC-SHA256 session signing secret (min 32 random chars)
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: set to "false" to allow HTTP cookies in dev (auto-false in NODE_ENV=development)
# DASHBOARD_COOKIE_SECURE=true


# ═══════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS  [At least one required for chat to work]
# ═══════════════════════════════════════════════════════════════════════════════

# OpenRouter (recommended — routes to 50+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Direct provider keys (optional fallbacks)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
MISTRAL_API_KEY=...
GROK_API_KEY=xai-...
PERPLEXITY_API_KEY=pplx-...
CEREBRAS_API_KEY=...


# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN / ON-CHAIN
# ═══════════════════════════════════════════════════════════════════════════════

# Alchemy — EVM wallet queries and on-chain operations
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_NETWORK=eth-mainnet

# Revenue wallet private key (used for automated payouts — keep VERY secure)
WALLET_PRIVATE_KEY=0x...

# Maximum single withdrawal (ETH)
MAX_WITHDRAW_ETH=0.5

# ERC-20 token contract address
FORGE_TOKEN_ADDRESS=0x...

# Per-chain minimum payout thresholds (ETH)
MIN_PAYOUT_ETH=0.01
MIN_PAYOUT_ETH_ETH_MAINNET=0.01
MIN_PAYOUT_ETH_BASE_MAINNET=0.005
MIN_PAYOUT_ETH_OPT_MAINNET=0.005
MIN_PAYOUT_ETH_ARB_MAINNET=0.005
MIN_PAYOUT_ETH_POLYGON_MAINNET=0.001

# Gas multipliers per chain
MIN_PAYOUT_GAS_MULTIPLIER=1.2
MIN_PAYOUT_GAS_MULTIPLIER_ETH_MAINNET=1.2

# Solana wallet (optional)
SOLANA_WALLET_ADDRESS=

# MultiversX / xPortal (optional)
MVX_ENABLED=false
MVX_DRY_RUN=true
MVX_WALLET_ADDRESS=


# ═══════════════════════════════════════════════════════════════════════════════
# TRADING BACKENDS
# ═══════════════════════════════════════════════════════════════════════════════

# OCI / Oracle Cloud trading backend
ORACLE_API_URL=https://your-oci-backend.example.com

# Coinbase Advanced Trade (handled by OCI backend — set keys there)

# Alpaca (equities + crypto)
ALPACA_ENABLED=false
ALPACA_DRY_RUN=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SYMBOLS=BTC/USD,ETH/USD

# Interactive Brokers
IBKR_ENABLED=false
IBKR_DRY_RUN=true
IBKR_GATEWAY_URL=http://localhost:4002
IBKR_ACCOUNT_ID=
IBKR_SYMBOLS=AAPL,MSFT

# Kalshi prediction markets
KALSHI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# ALERTS & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════

# Discord webhook for ops alerts (self-heal, health snapshots, weekly summaries)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALERT_SECRET=your-internal-api-secret
ALERT_MENTION=@ops


# ═══════════════════════════════════════════════════════════════════════════════
# AUTONOMY & AI ORCHESTRATION
# ═══════════════════════════════════════════════════════════════════════════════

# Admin key for autonomy mode control panel
AUTONOMY_ADMIN_KEY=replace-with-strong-secret

# AI intelligence mode (standard | enhanced | max)
MAX_INTELLIGENCE_MODE=standard

# Autonomy mode (off | advisory | autonomous)
AUTONOMY_MAX_MODE=advisory

# AI model pool sizes
AI_MIN_MODEL_COUNT=2
AI_MAX_MODEL_COUNT=5
AI_CRITICAL_MIN_MODEL_COUNT=3
AI_CRITICAL_MAX_MODEL_COUNT=7

# Per-query AI spend budgets (USD)
AI_QUERY_BUDGET_USD=0.05
AI_CRITICAL_QUERY_BUDGET_USD=0.20

# Prediction edge/reliability thresholds
PREDICTION_MIN_EDGE_FOR_ACTION=0.05
PREDICTION_MIN_RELIABILITY_FOR_ACTION=0.65

# Continuous learning intervals
CONTINUOUS_FORECAST_HORIZONS=1h,6h,24h
CONTINUOUS_POLICY_LIMIT=10
CONTINUOUS_ENABLE_INGEST=true
CONTINUOUS_INGEST_MIN_INTERVAL_HOURS=1

# Model synergy
MODEL_SYNERGY_ENABLED=false
MODEL_SYNERGY_MAX_CHAIN_STEPS=3
MODEL_SYNERGY_BUDGET_CAP=0.50


# ═══════════════════════════════════════════════════════════════════════════════
# SEARCH & KNOWLEDGE
# ═══════════════════════════════════════════════════════════════════════════════

# Tavily web search (used by MAX for real-time research)
TAVILY_API_KEY=tvly-...

# Chat message length limit
CHAT_MAX_MESSAGE_LENGTH=10000


# ═══════════════════════════════════════════════════════════════════════════════
# X / TWITTER AUTOMATION
# ═══════════════════════════════════════════════════════════════════════════════

X_HANDLE=@YourHandle
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_AUTOMATION_SECRET=your-x-api-secret
X_DRY_RUN=true
X_FORCE=false
X_POST_COOLDOWN_MINUTES=60
X_POST_DAILY_LIMIT=5


# ═══════════════════════════════════════════════════════════════════════════════
# PROTOCOL INTEGRATIONS (MCP / ACP / A2A / AUI)
# ═══════════════════════════════════════════════════════════════════════════════

MCP_ENABLED=false
MCP_HEALTH_URL=

ACP_ENABLED=false
ACP_HEALTH_URL=

A2A_ENABLED=false
A2A_HEALTH_URL=

AUI_ENABLED=false
AUI_HEALTH_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY (set automatically by Railway — do not set manually in production)
# ═══════════════════════════════════════════════════════════════════════════════

# RAILWAY_TOKEN=           # Used by GitHub Actions workflows only
# RAILWAY_PROJECT_ID=      # Used by GitHub Actions workflows only
# RAILWAY_SERVICE_ID=      # Used by GitHub Actions workflows only
# RAILWAY_ENVIRONMENT_ID=  # Used by GitHub Actions workflows only


# ═══════════════════════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SITE_URL=https://freedomforge.one
APP_BASE_URL=https://freedomforge.one

# Persistent data path (set to a Railway volume mount path in production)
# PERSISTENT_STORAGE_PATH=/data
