# AI Model APIs (priority order: Grok > OpenAI > Claude > OpenRouter > Perplexity > Groq > ...)
# ============================================
GROK_API_KEY=your_grok_api_key_here
GROK_ENDPOINT=https://api.x.ai/v1/chat/completions

# Optional: Add other AI providers for fallback
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Local/Self-Hosted Models
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Web Search API
# ============================================
# Sign up at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Alternative: Use DuckDuckGo (no API key needed)
# SEARCH_ENGINE=duckduckgo

# Alchemy (blockchain data) for Opera/Alchemy integration
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_NETWORK=eth-mainnet

# Revenue wallet (private key must be kept secret; funds go here)
WALLET_PRIVATE_KEY=your_revenue_wallet_private_key
REVENUE_RECIPIENTS=0xYourAddr1,0xYourAddr2
# Optional token payout mode (if set, distribute this ERC-20 token instead of native ETH)
# Example for Base bridged WETH: 0x4200000000000000000000000000000000000006
PAYOUT_TOKEN_ADDRESS=
# Minimum per-recipient payout for native ETH mode (as ETH string)
MIN_PAYOUT_ETH=0
# Minimum per-recipient payout for token mode (raw token wei)
MIN_PAYOUT_TOKEN_WEI=0
# Retries and delay for transfer attempts
DISTRIBUTION_MAX_RETRIES=3
DISTRIBUTION_RETRY_BASE_MS=1000
# Optional: send webhook alerts on successful transfers
ALERT_ON_SUCCESS=false

# Vector Database (optional for production)
# ============================================
# For production, consider:
# - Pinecone (https://pinecone.io)
# - Weaviate (https://weaviate.io)
# - Milvus (https://milvus.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=freedomforge

# Knowledge Base Settings
# ============================================
KB_AUTO_LOAD_DATASETS=true
KB_INCLUDE_WIKIPEDIA=true
KB_INCLUDE_ARXIV=true
KB_INCLUDE_GITHUB=true

# Debug & Logging
# ============================================
DEBUG=true
LOG_LEVEL=info

# -------------------------------------------------------------------------
# Additional settings for revenue wallet monitoring & dashboard
# -------------------------------------------------------------------------
# Dashboard credentials (required to view /dashboard)
DASHBOARD_USER=admin
DASHBOARD_PASS=supersecretpassword

# Optional alerting
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_SECRET=some-secret-value

# Health / distribution URLs (used by GitHub Actions and monitor script)
HEALTH_URL=https://yourapp.example.com/api/alchemy/health
DISTRIBUTION_URL=https://yourapp.example.com/api/alchemy/wallet/distribute

# public-facing alchemy keys for client-side usage
NEXT_PUBLIC_ALCHEMY_API_KEY=u7P8SD8T_y5-JA9yHJQ2G
NEXT_PUBLIC_ALCHEMY_POLICY_ID=c3535f26-23ec-4acb-89ec-6dacafd62e2a

# Monitor interval (ms)
MONITOR_INTERVAL_MS=900000

# Alchemy WebSocket mined tx subscription (optional)
# JSON array of filter objects, e.g.:
# [{"to":"0x9f3ce0ad29b767d809642a53c2bccc9a130659d7","from":"0x228f108fd09450d083bb33fe0cc50ae449bc7e11"},{"to":"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"}]
ALCHEMY_MINED_ADDRESSES_JSON=
ALCHEMY_HASHES_ONLY=true
ALCHEMY_INCLUDE_REMOVED=false

# Token tracking (optional)
# Provide a comma-separated list of ERC-20 contract addresses you want the
# dashboard to display. Balances are retrieved via Alchemy using the same
# API key.
TRACKED_TOKENS=0xTokenAddr1,0xTokenAddr2

# Gas top-up configuration (optional)
# If you want the system to automatically top up the revenue wallet's gas
# from a funding wallet, set `FUNDING_PRIVATE_KEY` and adjust thresholds:
FUNDING_PRIVATE_KEY=
GAS_TOPUP_THRESHOLD=0.01   # in ETH; when revenue wallet falls below this, top up
GAS_TOPUP_AMOUNT=0.05      # in ETH; amount to send when topping up
# ─────────────────────────────────────────────────────────────────────────────
# FreedomForge Max — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables marked [REQUIRED] will cause /api/health to return 503 if missing.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION  [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════════

# Dashboard login credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-strong-password

# HMAC-SHA256 session signing secret (min 32 random chars)
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: set to "false" to allow HTTP cookies in dev (auto-false in NODE_ENV=development)
# DASHBOARD_COOKIE_SECURE=true


# ═══════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS  [At least one required for chat to work]
# ═══════════════════════════════════════════════════════════════════════════════

# OpenRouter (recommended — routes to 50+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Direct provider keys (optional fallbacks)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
MISTRAL_API_KEY=...
GROK_API_KEY=xai-...
PERPLEXITY_API_KEY=pplx-...
CEREBRAS_API_KEY=...


# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN / ON-CHAIN
# ═══════════════════════════════════════════════════════════════════════════════

# Alchemy — EVM wallet queries and on-chain operations
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_NETWORK=eth-mainnet

# Revenue wallet private key (used for automated payouts — keep VERY secure)
WALLET_PRIVATE_KEY=0x...

# Maximum single withdrawal (ETH)
MAX_WITHDRAW_ETH=0.5

# ERC-20 token contract address
FORGE_TOKEN_ADDRESS=0x...

# Per-chain minimum payout thresholds (ETH)
MIN_PAYOUT_ETH=0.01
MIN_PAYOUT_ETH_ETH_MAINNET=0.01
MIN_PAYOUT_ETH_BASE_MAINNET=0.005
MIN_PAYOUT_ETH_OPT_MAINNET=0.005
MIN_PAYOUT_ETH_ARB_MAINNET=0.005
MIN_PAYOUT_ETH_POLYGON_MAINNET=0.001

# Gas multipliers per chain
MIN_PAYOUT_GAS_MULTIPLIER=1.2
MIN_PAYOUT_GAS_MULTIPLIER_ETH_MAINNET=1.2

# Solana wallet (optional)
SOLANA_WALLET_ADDRESS=

# MultiversX / xPortal (optional)
MVX_ENABLED=false
MVX_DRY_RUN=true
MVX_WALLET_ADDRESS=


# ═══════════════════════════════════════════════════════════════════════════════
# TRADING BACKENDS
# ═══════════════════════════════════════════════════════════════════════════════

# OCI / Oracle Cloud trading backend
ORACLE_API_URL=https://your-oci-backend.example.com

# Coinbase Advanced Trade (handled by OCI backend — set keys there)

# Alpaca (equities + crypto)
ALPACA_ENABLED=false
ALPACA_DRY_RUN=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SYMBOLS=BTC/USD,ETH/USD

# Interactive Brokers
IBKR_ENABLED=false
IBKR_DRY_RUN=true
IBKR_GATEWAY_URL=http://localhost:4002
IBKR_ACCOUNT_ID=
IBKR_SYMBOLS=AAPL,MSFT

# Kalshi prediction markets
KALSHI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# ALERTS & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════

# Discord webhook for ops alerts (self-heal, health snapshots, weekly summaries)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALERT_SECRET=your-internal-api-secret
ALERT_MENTION=@ops


# ═══════════════════════════════════════════════════════════════════════════════
# AUTONOMY & AI ORCHESTRATION
# ═══════════════════════════════════════════════════════════════════════════════

# Admin key for autonomy mode control panel
AUTONOMY_ADMIN_KEY=replace-with-strong-secret

# AI intelligence mode (standard | enhanced | max)
MAX_INTELLIGENCE_MODE=standard

# Autonomy mode (off | advisory | autonomous)
AUTONOMY_MAX_MODE=advisory

# AI model pool sizes
AI_MIN_MODEL_COUNT=2
AI_MAX_MODEL_COUNT=5
AI_CRITICAL_MIN_MODEL_COUNT=3
AI_CRITICAL_MAX_MODEL_COUNT=7

# Per-query AI spend budgets (USD)
AI_QUERY_BUDGET_USD=0.05
AI_CRITICAL_QUERY_BUDGET_USD=0.20

# Prediction edge/reliability thresholds
PREDICTION_MIN_EDGE_FOR_ACTION=0.05
PREDICTION_MIN_RELIABILITY_FOR_ACTION=0.65

# Continuous learning intervals
CONTINUOUS_FORECAST_HORIZONS=1h,6h,24h
CONTINUOUS_POLICY_LIMIT=10
CONTINUOUS_ENABLE_INGEST=true
CONTINUOUS_INGEST_MIN_INTERVAL_HOURS=1

# Model synergy
MODEL_SYNERGY_ENABLED=false
MODEL_SYNERGY_MAX_CHAIN_STEPS=3
MODEL_SYNERGY_BUDGET_CAP=0.50


# ═══════════════════════════════════════════════════════════════════════════════
# SEARCH & KNOWLEDGE
# ═══════════════════════════════════════════════════════════════════════════════

# Tavily web search (used by MAX for real-time research)
TAVILY_API_KEY=tvly-...

# Chat message length limit
CHAT_MAX_MESSAGE_LENGTH=10000


# ═══════════════════════════════════════════════════════════════════════════════
# X / TWITTER AUTOMATION
# ═══════════════════════════════════════════════════════════════════════════════

X_HANDLE=@YourHandle
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_AUTOMATION_SECRET=your-x-api-secret
X_DRY_RUN=true
X_FORCE=false
X_POST_COOLDOWN_MINUTES=60
X_POST_DAILY_LIMIT=5


# ═══════════════════════════════════════════════════════════════════════════════
# PROTOCOL INTEGRATIONS (MCP / ACP / A2A / AUI)
# ═══════════════════════════════════════════════════════════════════════════════

MCP_ENABLED=false
MCP_HEALTH_URL=

ACP_ENABLED=false
ACP_HEALTH_URL=

A2A_ENABLED=false
A2A_HEALTH_URL=

AUI_ENABLED=false
AUI_HEALTH_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY (set automatically by Railway — do not set manually in production)
# ═══════════════════════════════════════════════════════════════════════════════

