# ─────────────────────────────────────────────────────────────────────────────
# FreedomForge Max — Environment Variables
# Copy this file to .env.local and fill in your values.
# Variables marked [REQUIRED] will cause /api/health to return 503 if missing.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION  [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════════

# Dashboard login credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-strong-password

# HMAC-SHA256 session signing secret (min 32 random chars)
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: set to "false" to allow HTTP cookies in dev (auto-false in NODE_ENV=development)
# DASHBOARD_COOKIE_SECURE=true


# ═══════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS  [At least one required for chat to work]
# ═══════════════════════════════════════════════════════════════════════════════

# OpenRouter (recommended — routes to 50+ models)
OPENROUTER_API_KEY=sk-or-v1-...

# Direct provider keys (optional fallbacks)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
MISTRAL_API_KEY=...
GROK_API_KEY=xai-...
PERPLEXITY_API_KEY=pplx-...
CEREBRAS_API_KEY=...

# Blackbox AI — coding-specialized model routing (set BLACKBOX_ENABLED=true to activate)
BLACKBOX_ENABLED=false
BLACKBOX_KEY=
BLACKBOX_API_KEY=
BLACKBOX_MODEL=blackbox-code-fast
BLACKBOX_ENDPOINT=https://api.blackbox.ai/api/chat

# Decentralized AI Networks — fallback-only (activated when all primary providers fail)
# Each key is optional and independent; omit any you don't use.
AKASH_API_KEY=
AKASH_MODEL=Meta-Llama-3-1-405B-Instruct-FP8
AKASH_ENDPOINT=https://chatapi.akash.network/api/v1/chat/completions
CORCEL_API_KEY=
CORCEL_MODEL=cortext-ultra
CORCEL_ENDPOINT=https://api.corcel.io/v1/text/cortext/chat
IONET_API_KEY=
IONET_MODEL=llama-3.1-70b
IONET_ENDPOINT=https://api.io.net/v1/chat/completions
ZEROG_API_KEY=
ZEROG_MODEL=0g-serving-model
ZEROG_ENDPOINT=https://rpc.0g.ai/v1/chat/completions


# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN / ON-CHAIN
# ═══════════════════════════════════════════════════════════════════════════════

# Alchemy — EVM wallet queries and on-chain operations
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_NETWORK=eth-mainnet

# Revenue wallet private key (used for automated payouts — keep VERY secure)
WALLET_PRIVATE_KEY=0x...

# Maximum single withdrawal (ETH)
MAX_WITHDRAW_ETH=0.5

# $FORGE ERC-20 contract address — set this after running: npm run contract:deploy:base
FORGE_TOKEN_ADDRESS=0x...

# Payout token address — set to USDC (Base) or the deployed FORGE address
# USDC on Base:     0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC on Ethereum: 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
PAYOUT_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
MIN_PAYOUT_TOKEN_WEI=1000000

# Comma-separated ERC-20 token contract addresses to monitor on-chain.
# DO NOT include the zero address (0x000...0000) or native-token sentinel (0xEeee...eE).
# Add FORGE_TOKEN_ADDRESS here once deployed.
# Defaults: AERO (Base), MATIC (Polygon), ARB (Arbitrum)
TRACKED_TOKENS=0x4200000000000000000000000000000000000042,0x0000000000000000000000000000000000001010,0x912CE59144191C1204E64559FE8253a0e49E6548

# ── Conversion Engine ────────────────────────────────────────────────────────
# Automatically swaps native-chain gas tokens → stablecoins for revenue capture.
# Native token sentinel (0xEeee...eE) means "use the chain's native ETH/MATIC/etc"
CONVERSION_ENGINE_ENABLED=false
CONVERSION_ENGINE_DRY_RUN=true
CONVERSION_NETWORKS=base-mainnet
# Base mainnet: swap native ETH → USDC
CONVERSION_FROM_TOKEN_BASE_MAINNET=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
CONVERSION_TO_TOKEN_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Ethereum mainnet (only needed if CONVERSION_NETWORKS includes eth-mainnet):
# CONVERSION_FROM_TOKEN_ETH_MAINNET=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE
# CONVERSION_TO_TOKEN_ETH_MAINNET=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
CONVERSION_MIN_NATIVE_RESERVE_ETH_BASE_MAINNET=0.01
CONVERSION_SLIPPAGE_BPS_BASE_MAINNET=60
CONVERSION_SELL_BALANCE_PCT_BASE_MAINNET=40
# 0x API key for swap quotes (https://0x.org/docs/introduction/getting-started)
ZEROX_API_KEY=

# Per-chain minimum payout thresholds (ETH)
MIN_PAYOUT_ETH=0.01
MIN_PAYOUT_ETH_ETH_MAINNET=0.01
MIN_PAYOUT_ETH_BASE_MAINNET=0.005
MIN_PAYOUT_ETH_OPT_MAINNET=0.005
MIN_PAYOUT_ETH_ARB_MAINNET=0.005
MIN_PAYOUT_ETH_POLYGON_MAINNET=0.001

# Gas multipliers per chain
MIN_PAYOUT_GAS_MULTIPLIER=1.2
MIN_PAYOUT_GAS_MULTIPLIER_ETH_MAINNET=1.2

# Solana wallet (optional)
SOLANA_WALLET_ADDRESS=

# MultiversX / xPortal (optional)
MVX_ENABLED=false
MVX_DRY_RUN=true
MVX_WALLET_ADDRESS=


# ═══════════════════════════════════════════════════════════════════════════════
# TRADING BACKENDS
# ═══════════════════════════════════════════════════════════════════════════════

# OCI / Oracle Cloud trading backend
ORACLE_API_URL=https://your-oci-backend.example.com

# Coinbase Advanced Trade (handled by OCI backend — set keys there)

# Alpaca (equities + crypto)
ALPACA_ENABLED=false
ALPACA_DRY_RUN=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SYMBOLS=BTC/USD,ETH/USD

# Interactive Brokers
IBKR_ENABLED=false
IBKR_DRY_RUN=true
IBKR_GATEWAY_URL=http://localhost:4002
IBKR_ACCOUNT_ID=
IBKR_SYMBOLS=AAPL,MSFT

# Kalshi prediction markets
KALSHI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# ALERTS & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════

# Discord webhook for ops alerts (self-heal, health snapshots, weekly summaries)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
ALERT_SECRET=your-internal-api-secret
ALERT_MENTION=@ops


# ═══════════════════════════════════════════════════════════════════════════════
# AUTONOMY & AI ORCHESTRATION
# ═══════════════════════════════════════════════════════════════════════════════

# Admin key for autonomy mode control panel
AUTONOMY_ADMIN_KEY=replace-with-strong-secret

# AI intelligence mode (standard | enhanced | max)
MAX_INTELLIGENCE_MODE=standard

# Autonomy mode (off | advisory | autonomous)
AUTONOMY_MAX_MODE=advisory

# AI model pool sizes
AI_MIN_MODEL_COUNT=2
AI_MAX_MODEL_COUNT=5
AI_CRITICAL_MIN_MODEL_COUNT=3
AI_CRITICAL_MAX_MODEL_COUNT=7

# Per-query AI spend budgets (USD)
AI_QUERY_BUDGET_USD=0.05
AI_CRITICAL_QUERY_BUDGET_USD=0.20

# Prediction edge/reliability thresholds
PREDICTION_MIN_EDGE_FOR_ACTION=0.05
PREDICTION_MIN_RELIABILITY_FOR_ACTION=0.65

# Continuous learning intervals
CONTINUOUS_FORECAST_HORIZONS=1h,6h,24h
CONTINUOUS_POLICY_LIMIT=10
CONTINUOUS_ENABLE_INGEST=true
CONTINUOUS_INGEST_MIN_INTERVAL_HOURS=1

# Model synergy
MODEL_SYNERGY_ENABLED=false
MODEL_SYNERGY_MAX_CHAIN_STEPS=3
MODEL_SYNERGY_BUDGET_CAP=0.50


# ═══════════════════════════════════════════════════════════════════════════════
# SEARCH & KNOWLEDGE
# ═══════════════════════════════════════════════════════════════════════════════

# Tavily web search (used by MAX for real-time research)
TAVILY_API_KEY=tvly-...

# Chat message length limit
CHAT_MAX_MESSAGE_LENGTH=10000


# ═══════════════════════════════════════════════════════════════════════════════
# X / TWITTER AUTOMATION
# ═══════════════════════════════════════════════════════════════════════════════

X_HANDLE=@YourHandle
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_AUTOMATION_SECRET=your-x-api-secret
X_DRY_RUN=true
X_FORCE=false
X_POST_COOLDOWN_MINUTES=60
X_POST_DAILY_LIMIT=5


# ═══════════════════════════════════════════════════════════════════════════════
# PROTOCOL INTEGRATIONS (MCP / ACP / A2A / AUI)
# ═══════════════════════════════════════════════════════════════════════════════

MCP_ENABLED=false
MCP_HEALTH_URL=

ACP_ENABLED=false
ACP_HEALTH_URL=

A2A_ENABLED=false
A2A_HEALTH_URL=

AUI_ENABLED=false
AUI_HEALTH_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# RAILWAY (set automatically by Railway — do not set manually in production)
# ═══════════════════════════════════════════════════════════════════════════════

# RAILWAY_TOKEN=           # Used by GitHub Actions workflows only
# RAILWAY_PROJECT_ID=      # Used by GitHub Actions workflows only
# RAILWAY_SERVICE_ID=      # Used by GitHub Actions workflows only
# RAILWAY_ENVIRONMENT_ID=  # Used by GitHub Actions workflows only


# ═══════════════════════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SITE_URL=https://freedomforge.one
APP_BASE_URL=https://freedomforge.one

# Persistent data path (set to a Railway volume mount path in production)
# PERSISTENT_STORAGE_PATH=/data


# ═══════════════════════════════════════════════════════════════════════════════
# CONNECTION STABILITY (Offline Queue, Health Checks, Rate Limiting)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Redis (Distributed Rate Limiting) ────────────────────────────────────────
# For Railway: Auto-injected as REDIS_URL when you add Redis add-on
# For local development: Start with: docker run -d -p 6379:6379 redis:7
# Then set: REDIS_URL=redis://localhost:6379
REDIS_URL=

# ── Health Check Settings ────────────────────────────────────────────────────
# OCI Backend health check timeout (ms)
OCI_HEALTH_CHECK_TIMEOUT_MS=2000
# Exchange health check timeout (ms)
EXCHANGE_HEALTH_CHECK_TIMEOUT_MS=2000

# ── Offline Queue Settings ───────────────────────────────────────────────────
# Max retry attempts before giving up on queued mutation
OFFLINE_QUEUE_MAX_ATTEMPTS=5

# ── On-Chain Tracking (Polygon) ──────────────────────────────────────────────
# Get free API key at: https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Primary wallet address for yield accrual tracking and proof of income
POLYGON_WALLET_ADDRESS=0x42CF77Ce0F1Abb52Ec6A677b2468679a39bB6c4B
# Comma-separated tx hashes to monitor in Phase 1 dashboard
TRACKED_TX_HASHES=
# NonKyc.io exchange credentials
NONKYC_API_KEY=
NONKYC_API_SECRET=


# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE — Realtime + Auth (Admin Dashboard)
# Get your project URL and anon key from https://app.supabase.com
# ═══════════════════════════════════════════════════════════════════════════════

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose — row-level security enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — NEVER expose to the browser; server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
